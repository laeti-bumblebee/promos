{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "enabledManagers": ["custom.regex"],
  "dependencyDashboard": false,
  "vulnerabilityAlerts": { "enabled": false },
  "automerge": true,
  "automergeType": "pr",
  "platformAutomerge": false,
  "packageRules": [
    {
      "matchUpdateTypes": ["major", "digest"],
      "automerge": false
    }
  ],
  "customManagers": [
    {
      "customType": "regex",
      "managerFilePatterns": ["/^nuxt\\.config\\.ts$/"],
      "matchStrings": ["const layersCommit = \"(?<currentDigest>[0-9a-f]{40})\"; // app-layers-v(?<currentValue>\\d+\\.\\d+\\.\\d+)"],
      "depNameTemplate": "chamboug/bivouac",
      "datasourceTemplate": "github-tags",
      "extractVersionTemplate": "^app-layers-v(?<version>\\d+\\.\\d+\\.\\d+)$"
    }
  ]
}
